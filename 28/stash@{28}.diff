+const makeProxy = (callback) =>
+  new Proxy(
+    {},
+    {
+      get: function (target, property, receiver) {
+        return callback(property);
+      },
+    },
+  );
+
+//click: (locFunc, ...params) => locFunc()
+
+// bindPageCall(/*the callback that gets the locator function*/)
+// locatorActions.click(bindPageCall)
+
+//callBack ShouldProduce a locator.
+const bindPageCall =
+  (locatorFunc) =>
+  ({ page }) =>
+    locatorFunc(page);
+
+const getCallObjectItems = (item) => Object.entries(item)[0];
+
+const controlBy = (callObject, ...options) => {
+  const [key, value] = getCallObjectItems(callObject);
+  return [key, value, ...options];
+};
+
+//const selectConus = controlBy({getByText: 'Starts and ends in the continental US'}).
+
+const selector = (call, ...locatorOptions) => {
+  // locatorProxy.type(firstName) <- invocation of the build symbol.
+  const locatorProxy = makeProxy((functionKey) => {
+    if (functionKey === 'from') {
+      const [pageFuncName, ...options] = controlBy(call, ...locatorOptions);
+      return (page) => page[pageFuncName](...options);
+    }
+
+    //return build so we can pass the parameters we want to execute with
+    const build = (...callParams) => {
+      //we bind selectFunc so we can use 'this', which is the object that has locator functions (page/locator)
+      const selectFunc = (page) => {
+        //get the locator
+        const [pageFuncName, ...options] = controlBy(call, ...locatorOptions);
+        const pageLocator = page[pageFuncName](...options);
+        //execute the locator function (prop)
+        const locatorFunc = pageLocator[functionKey].bind(pageLocator);
+        const invokeCallParams = callParams.map((e) => (typeof e === 'function' ? e() : e));
+        //pageLocator.count().then((e) => console.log(e));
+        return locatorFunc(...invokeCallParams);
+      };
+
+      //this will be setup to execute 'selectFunc' on the page object.
+      //when this happens, it will immediately invoke the function with the options provided
+      const theLocatorFunction = bindPageCall(selectFunc);
+      return theLocatorFunction;
+    };
+    return build;
+  });
+
+  return locatorProxy;
+};
