+const withName = (obj) => (typeof obj === 'object' && 'name' in v && 'name') || JSON.stringify(obj);
+
+/**
+ * Default run function that sets up and executes a test scenario.
+ *
+ * @param {Function} a - The function representing the test scenario.
+ * @param {Array} testCases - An array of test cases for the scenario.
+ * @returns {Function} - An asynchronous function that runs the provided scenario function with the specified options.
+ */
+const defaultRun =
+  (runFunc, ...options) =>
+  async ({ pageInstance }) => {
+    //run({pageInstance}, ...options);
+    await runFunc(pageInstance, ...options);
+  };
+
+/**
+ * Orchestrates the execution of test scenarios based on the provided options.
+ *
+ * @param {Object} options - Options for running test scenarios.
+ * @param {Array} options.testCases - An array of test cases to be executed (default is [undefined]).
+ * @param {Function} options.setupRun - The setup function for the scenario run (default is `defaultRun`).
+ * @param {Function} options.run - The function representing the test scenario.
+ * @param {string} options.name - The name of the test scenario.
+ * @param {Function} options.op - The operation to be performed for each test case.
+ * @returns - No return. The tests will execute from the for loop, but there is no object to wait on.
+ */
+const runScenario = async ({ testCases = [undefined], setupRun = defaultRun, run, name, op }) => {
+  const items = testCases.map((testCase) => {
+    const testFunction = setupRun(run, { testCases });
+    return [`${name} ${(testCase === undefined && ' ') || ('case' && withName(testCase))}`, testFunction];
+  });
+  //a should be ({pageInstance}) => {/* literal running context */};
+  for (let a of items) {
+    await op(...a);
+  }
+};
+
+/**
+ * This function creates a scenario suite that provides the ability to run test scenarios and offers additional features for working with Playwright.
+ *@param {Object} op - Additional options for the scenario suite.
+ * @returns {Object} - An object containing properties for describing tests, running scenarios, and defining individual scenarios.
+ */
+export const scenarioSuite = (op) => ({
+  /**
+   * Creates a scenario with the specified options and run function.
+   *
+   * @param {Object} scenarioOptions - Options for the scenario.
+   * @param {Function} run - The function to run for the scenario.
+   * @returns {Function} - A function representing the created scenario.
+   */
+  createScenario(scenarioOptions, run) {
+    return runScenario({ run, op, ...scenarioOptions });
+  },
+
+  /**
+   * Runs a scenario with the specified options, test cases, run function, and setup run function.
+   *
+   * @param {Object} options - Options for the scenario.
+   * @param {string} options.name - The name of the scenario.
+   * @param {Array} options.testCases - An array of test cases for the scenario.
+   * @param {Function} options.run - The function to run for the scenario.
+   * @param {Function} options.setupRun - The setup function for the scenario run (default is `defaultRun`).
+   * @returns {Promise} - A promise that resolves when the scenario is completed.
+   */
+  scenario ({ name, testCases: testCases, run, setupRun }) {
+    return runScenario({ op, name, testCases, run, setupRun });
+  },
+});
+
+export const actionArray =
+  (input, ...options) =>
+  ({ pageInstance }) => {
+    const promiseOfParams = Promise.resolve([{ pageInstance }, ...options]);
+    const stepParams = Promise.resolve(pageInstance);
+
+    const waitForStep = async (step) => {
+      await (typeof step == 'function' ? await stepParams.then(step) : Promise.resolve(step));
+    };
+
+    const runQueue = promiseOfParams
+      .then(async (parameters) => await input(...parameters))
+      .then(
+        async (queue) =>
+          await queue.reduce((calls, step) => calls.then(async (a) => await waitForStep(step)), stepParams),
+      );
+    return runQueue;
+  };
+
+
