+import { expect } from "../../mixedTestSetup";
+import { ordersContextObjectWithMoves, serviceMemberLoginObject } from '../shapesAndModels/expectShapes';
+export const handleErrors = (error) => new Promise((res, err) => err(error));
+
+export const onResponse = (validate, interpret) => (response) =>
+  new Promise(async (res, err) => {
+    const validationResult = await validate(response);
+    try {
+      if (!validationResult) return err(`invalid response: ${JSON.stringify(response)}`);
+      const result = response
+        .finished()
+        .then(async (success) => await interpret(response))
+        .catch(handleErrors)
+        .then((interpretedData) => res({ status: response.status, eventData: interpretedData }));
+    } catch (error) {
+      err(error);
+    }
+  });
+
+/**
+ * {}.handleResponse(url, handle, callback)
+ * @argument url, the complete url for the response
+ * @argument handle: takes response object, must be async, and throw or reject when unable to parse the response.
+ * @argument callback: the callback that is called if handle succeeds.
+ * @returns the response service.
+ */
+export const responseService = () => {
+  const self = { urlChecks: [], handlers: {} };
+  const handleResponse = ({ checkUrl, key }, handle, callback) => {
+    if (key in self.handlers) throw new Error(`handler for ${key} is already set`);
+    self.urlChecks.push({ key, checkUrl });
+    self.handlers[key] = { handle, callback };
+  };
+  self.handleResponse = handleResponse;
+
+  self.start = async ({ page }, handlers = self.handlers, urlChecks = self.urlChecks) =>
+    page.on('response', async (response) => {
+      const url = response.url();
+      const [{ key, checkUrl } = {}, ...rest] = urlChecks.filter(({ key, checkUrl }) => checkUrl(url));
+      //handle this case with another function that explicitly deals with this case later on...
+      if (rest.length > 0)
+        throw new Error(
+          `multiple handlers for the same endpoint ${url} have been set for: ${[key, ...rest.map((e) => e.key)].join(
+            ',',
+          )}`,
+        );
+      const handlerValue = handlers[key];
+      if (!handlerValue) return;
+
+      const { handle, callback } = handlerValue;
+      try {
+        const result = handle(response).catch(handleErrors);
+        await result.then(callback);
+      } catch (error) {}
+    });
+
+  return self;
+};
+
+/** returns the async ({ page }) action. this allows us to use the other helper functions to listen for the handler receiver */
+export const runResponseHandler = (
+  { checkUrl, key },
+  handleResponse,
+  responseHandler,
+  { validate, onValidResponse },
+) => {
+  let id = 0;
+  const smData = {};
+  const stack = [];
+  const waitForObject = {};
+  const setWaiter = () => {
+    const waiter = new Promise((proceed) => (waitForObject.proceed = proceed));
+    const idValue = id++;
+    waitForObject.waiter = { promise: waiter, id: idValue };
+    stack.unshift(id);
+  };
+  setWaiter();
+
+  const responseCallback = ({ status, eventData }) => {
+    const waiter = waitForObject.waiter;
+    waiter.eventData = eventData;
+    smData[waitForObject.id] = waiter;
+    const { proceed } = waitForObject;
+    setWaiter();
+    proceed(eventData);
+  };
+
+  handleResponse({ checkUrl, key }, responseHandler, responseCallback);
+
+  return (expecting) => async () => {
+    const activeWaiter = waitForObject.waiter;
+    const recentWaiter = stack[0];
+    const currentWaiter = smData[recentWaiter];
+    if (activeWaiter.id === recentWaiter) activeWaiter = currentWaiter;
+
+    await activeWaiter.promise;
+    expecting && expect(activeWaiter.eventData).toEqual(expecting);
+    const isValid = validate && (await validate(activeWaiter.eventData, expecting));
+    if (!isValid) return;
+
+    onValidResponse && (await onValidResponse(activeWaiter.eventData));
+  };
+};
+
+export const jsonResponse = onResponse(
+  async (response) => await response.ok(),
+  async (response) => {
+    console.log(response);
+    try {
+      const jsonResult = response
+        ?.text()
+        .catch(handleErrors)
+        .then((success) => JSON.parse(success));
+
+      const result = await jsonResult;
+      if (!result) return '{}';
+      return await result;
+    } catch (error) {
+      console.log(response);
+      console.log(error);
+    }
+  },
+);
+
+const INTERNAL_USERS_LOGIN_PATH = 'http://milmovelocal:3000/internal/users/logged_in';
+export const expectServiceMemberLoginResponse = (handleResponse, { onValidResponse } = {}) => {
+  const check = { checkUrl: (url) => url === INTERNAL_USERS_LOGIN_PATH, key: 'serviceMemberLoggedIn' };
+  const validate = (value) => {
+    expect(value).toEqual(serviceMemberLoginObject);
+    return true;
+  };
+  const theResponse = runResponseHandler(check, handleResponse, jsonResponse, {
+    validate,
+    onValidResponse,
+  });
+  return theResponse;
+};
+
+const INTERNAL_ORDERS_PATH =
+  'http://milmovelocal:3000/internal/service_members/c36473a1-52af-4cb2-8201-d8c06bcc7ce8/current_orders';
+export const expectOrdersContextResponse = (handleResponse, { onValidResponse }) => {
+  const regex = /^.*\/internal\/service_members\/.*\/current_orders$/;
+  const check = { checkUrl: (url) => regex.test(url), key: 'currentOrders' };
+  const validate = (value) => {
+    expect(value).toEqual(ordersContextObjectWithMoves);
+    return true;
+  };
+  const theResponse = runResponseHandler(check, handleResponse, jsonResponse, {
+    validate,
+    onValidResponse,
+  });
+  return theResponse;
+};
