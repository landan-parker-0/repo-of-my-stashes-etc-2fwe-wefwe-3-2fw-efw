+const locatorProxy = () => {
+  let source = { execution: [] };
+
+  const getAction = (name) => {
+    const result = {};
+
+    result.action = () => {};
+
+    result.paramsAction = () => {};
+
+    return result;
+  };
+
+  const proxValues = {
+    get: function ({ execution, ...remaining }, property, receiver) {
+      const nextProxy = { execution: [...execution], ...remaining };
+
+      const appendAction = (name) => {
+        const { action, paramsAction } = getAction(name);
+        execution.push(action);
+        return paramsAction;
+      };
+
+      //create instance functions that get called on the locator when instantiated.
+      return new Proxy(nextProxy, proxValues);
+    },
+  };
+
+  const baseProxy = new Proxy(source, proxValues);
+
+  const locatorBase = {};
+
+  const locatorInstance = async (page) => {
