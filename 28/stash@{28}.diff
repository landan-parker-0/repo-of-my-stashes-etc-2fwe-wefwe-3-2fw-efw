+import { PROFILE_CREATION } from './staticElementConstants';
+
+const reconstructObjectWithFunc = (obj, func) => Object.fromEntries(Object.entries(obj).map(func));
+
+export const reMap = reconstructObjectWithFunc;
+
+const selectorTypeMap = { input: '', label: '', select: '', div: '', span: '', p: '', button: '' };
+const selectorTargetMap = { name: '', for: '', ['data-testid']: '', ['data-hook']: '', id: '' };
+const selectorActionMap = { click: '', selectOption: '', type: '' };
+
+const createControlsMap = function(self){
+  self.registerControl = ((control) => {
+    control.id = this.getNextId();
+    this.controls[control.id] = control;
+    return control.id;
+  }).bind(self);
+  self.getNextId = (() => this.id++);
+  return self;
+};
+
+const controlsMap = { id: 0, controls: [] };
+createControlsMap.bind(controlsMap)(controlsMap);
+
+let protoTypes = {};
+
+//get the prototype functions of Locator.
+//build an array of functions that reference the locator func and take a selector, then bind to that selector instance for that event, and return the map of functions.
+
+export const controlsPicking = (quickItems = ([iType, iTarget, iAction] = [])) => {
+  let self = {
+    selectorType: undefined,
+    selectorTarget: undefined,
+    selectorAction: undefined,
+    setSelectorType: undefined,
+    setSelectorTarget: undefined,
+    setSelectorAction: undefined,
+  };
+
+  let opType = (actionLabel, e, v, item) => {
+    self[actionLabel] = (a) => a[e];
+    return self;
+  };
+
+  let opTarget = (actionLabel, e, v, item) => {
+    self.selectorProperty = e;
+    self.selectorTargetValue = item;
+    self[actionLabel] = (a) => {
+      let locatorValue = a[e](self.selectorTargetValue[self.selectorProperty]);
+      let locator = {[e]: locatorValue, };
+      return locator;
+    };
+
+    return self;
+  };
+
+  let opAction = (actionlabel, e, v, item) => {
+    self.eventName = e;
+    self[actionlabel] = (a) => ({ exe: a[self.eventName].bind(a) });
+    return self;
+  };
+
+  let onSelector = (operation, set, key) =>
+    reconstructObjectWithFunc(set, ([e, v]) => [e, (item) => operation(key, e, v, item)]);
+
+  let onDefault = (obj, found) => {
+    if (!found) return console.log('nope') || self;
+    found[1](obj);
+    return self;
+  };
+
+  const getEntry = (set, obj) => {
+    const found = Object.entries(set).find(([e]) => e in obj);
+    if (!found) return;
+    return found;
+  };
+  const getDefault = (set) => (obj) => onDefault(obj, obj && getEntry(set, obj));
+
+  const allTagTypes = onSelector(opType, selectorTypeMap, 'selectorType');
+  self.setSelectorType = getDefault(allTagTypes);
+
+  const allTargets = onSelector(opTarget, selectorTargetMap, 'selectorTarget');
+  self.setSelectorTarget = getDefault(allTargets);
+
+  const allActions = onSelector(opAction, selectorActionMap, 'selectorAction');
+  self.setSelectorAction = getDefault(allActions);
+
+  self.setSelectorItems = ([sType, sTarget, sAction]) =>
+    self.setSelectorType(sType).setSelectorTarget(sTarget).setSelectorAction(sAction);
+
+  if (quickItems.length == 3) self.setSelectorItems(quickItems);
+
+  self.getSelectorItems = () => [self.selectorType, self.selectorTarget, self.selectorAction];
+
+  self.setup = () => {
+    controlsMap.registerControl(self);
+    self.getSelectors = (selectors) => {
+      const selectorType = self.selectorType(selectors);
+      const selectorTarget = self.selectorTarget(selectorType)[self.selectorProperty];
+      self.selector = selectorTarget;
+    };
+
+    return (value) =>
+      async ({ helpers: { locatorHelpers: selectors } }) => {
+        self.getSelectors(selectors);
+        await (value ? self.selectorAction(self.selector).exe(value) : self.selectorAction(self.selector).exe());
+      };
+  };
+
+  return self;
+};
