+export const generateShortGuid = () => {
+  return 'xxxxxxxxxxxx4xxxyxxxxx'.replace(/[xy]/g, function (c) {
+    const r = (Math.random() * 16) | 0;
+    const v = c === 'x' ? r : (r & 0x3) | 0x8;
+    return v.toString(16);
+  });
+};
+
+const swapHyphensForUnderscores = (str) => str.split('-').join('_');
+
+const KeysToValueFunction = (obj, val) => Object.fromEntries(Object.entries(obj).map(([key]) => [key, val(key)]));
+
+const locatorText = (page, locator) => (modifier) => (text) => page.locator(`${locator}[${modifier}='${text}']`);
+
+const applyPageToLocatorText = (page) => (locator) => KeysToValueFunction(locatorModifiers, locatorText(page, locator));
+
+export const locatorHelpers = (page) => ({
+  ...KeysToValueFunction(tagLocators, applyPageToLocatorText(page)),
+});
+
+export const waitAfterAction = (waiting, action) => {
+  let waiter = null;
+  return [
+    async (page) => {
+      waiter = waiting(page);
+    },
+    action,
+    async (page) => waiter,
+  ];
+};
+
+export const waitForFileUpload = (locatorAction, filePath) => {
+  const actions = waitAfterAction(({ page }) => {
+    return page.waitForEvent('filechooser');
+  }, locatorAction);
+
+  const lastActionProvidesFileInput = actions[actions.length - 1];
+
+  const setFiles = async ({ page }) => {
+    const fileInput = await lastActionProvidesFileInput({ page });
+    // .then(async (e,r) =>{
+    //   const ee = await e;
+    // });
+    await fileInput.setFiles(filePath);
+  };
+
+  const result = [...actions, setFiles];
+  return result;
+};
+
+export const nextPageAfterControl = (path, control) =>
+  waitAfterAction(({ page }) => {
+    return page.waitForURL(path);
+  }, control);
