+import { checkA11y, getAxeResults, injectAxe } from 'axe-playwright';
+import { CustomerPpmPage } from './my/milmove/ppms/customerPpmTestFixture';
+import { CustomerPpmOnboardingPage } from './my/milmove/ppms/entireShipmentOnboarding.spec';
+import { test as customerTest } from './utils/my/customerTest';
+
+const proxyPage = (self, { before, after } = { before: () => {}, after: () => {} }) =>
+  new Proxy(self, {
+    get: (source, prop) => {
+      const foundItem = typeof self[prop] === 'function' && self[prop];
+      if (!foundItem) return self[prop];
+
+      const defer = (...options) =>
+        Promise.resolve()
+          .then(async () => await before())
+          .then(async () => await foundItem.bind(self)(...options))
+          .then(async (a) => await Promise.resolve(await after()).then(a));
+      return defer;
+    },
+  });
+
+const setupAudit = async (pom) => {
+  const thePage = pom.page || pom;
+  const page = { ...thePage };
+
+  const hasAxe = page.states.hasAxe;
+  if (!hasAxe)
+    await Promise.resolve((page.states.hasAxe = true))
+      .then(async () => await injectAxe(thePage))
+      .then(
+        async () =>
+          await checkA11y(
+            thePage,
+            undefined,
+            {
+              detailedReport: true,
+            },
+            // skip failures
+            true,
+            'html',
+          ),
+      )
+      .then(async () => await getAxeResults(thePage));
+  //const violations = (await getAxeResults(page)).violations;
+  //if (violations.length > 0) '';
+};
+
+const setupPageFor = (pom) => {
+  (pom.page || pom).states = {};
+  return proxyPage(pom, {
+    before: () => setupAudit(pom),
+    after: () => setupAudit(pom),
+  });
+};
+
+const customerPpmFixtures = {
+  customerPpmPage: async ({ customerPage }, use) => {
+    let customerPpmPage = new CustomerPpmPage(customerPage);
+    const customerProxyPage = setupPageFor(customerPpmPage);
+    await use(customerProxyPage);
+  },
+  customerPpmOnboardingPage: async ({ customerPpmPage }, use) => {
+    let customerPpmOnboardingPage = new CustomerPpmOnboardingPage(customerPpmPage);
+    const customerProxyPage = setupPageFor(customerPpmOnboardingPage);
+    await use(customerProxyPage);
+  },
+};
+
+export const test = customerTest.extend(customerPpmFixtures);
