+// @ts-nocheck
+import { stringHelpers as str } from './testActionUtils';
+import { serviceMemberMatch } from './MixedUtilities/ApiMatches'
+
+export const TOOOfficeUserType = 'TOO office';
+export const TIOOfficeUserType = 'TIO office';
+export const QAECSROfficeUserType = 'QAE/CSR office';
+export const ServicesCounselorOfficeUserType = 'Services Counselor office';
+export const PrimeSimulatorUserType = 'Prime Simulator office';
+export const MultiRoleOfficeUserType = 'Multi role office';
+export const MilmoveUserType = 'milmove';
+
+export const allUserTypes = {
+  TOOOfficeUserType,
+  TIOOfficeUserType,
+  QAECSROfficeUserType,
+  ServicesCounselorOfficeUserType,
+  PrimeSimulatorUserType,
+  MultiRoleOfficeUserType,
+  MilmoveUserType,
+};
+
+export const URL_PATHS = {
+  ROOT_PATH: '/',
+  DEV_LOGIN_PATH: 'devlocal-auth/login',
+  SIGN_IN_PATH: 'sign-in',
+};
+
+export const compareUrlPath =
+  (check) =>
+  ({ pathname }) =>
+    str.trimOuterSymbols(pathname, '/') === check;
+
+export const RegularPathChecks = {
+  DEV_LOGIN_PATH: ({ pathname }) => pathname === URL_PATHS.DEV_LOGIN_PATH,
+  ROOT_PATH_CHECK: ({ pathname }) => pathname === URL_PATHS.ROOT_PATH,
+  SIGN_IN_PATH_CHECK: compareUrlPath(URL_PATHS.SIGN_IN_PATH),
+};
+
+export const waitForSignout = async ({ page }) => {
+  await page.getByText('Sign out').click();
+};
+
+//officelocalt:3000/devlocal-auth/login
+/** Navigates to a path on the current domain */
+export const waitForPageNavigation = async ({ page, path }) => {
+  const urlWaiter = page.waitForURL(compareUrlPath(path));
+  const currentUrl = page.url();
+  const baseUrl = new URL(currentUrl).origin;
+  const loginUrl = str.concatUrlSegments([baseUrl, path]);
+  await page.goto(loginUrl);
+  await urlWaiter;
+};
+
+// officelocal:3000 for the PATH_CHECK, for example
+export const waitForLoginPage = async ({ page, navToUrl, PATH_CHECK = RegularPathChecks.SIGN_IN_PATH_CHECK }) => {
+  const urlWaiter = page.waitForURL(PATH_CHECK);
+  await page.goto(navToUrl);
+  await urlWaiter;
+};
+
+const clickNewLoginForUser =
+  (userType) =>
+  async ({ page }) =>
+    await page.locator(`button[data-hook="new-user-login-${userType}"]`).click();
+
+const loginAs = Object.entries({
+  ...allUserTypes,
+}).reduce((logins, [key, value]) => {
+  logins[key] = clickNewLoginForUser(value);
+  return logins;
+}, {});
+
+// TODO map this
+/*
+async signInAsExistingOfficeUser(email) {
+  await this.page.goto('/devlocal-auth/login');
+  await this.page.locator('input[name=email]').fill(email);
+  await this.page.locator('p', { hasText: 'User Email' }).locator('button').click();
+}
+*/
+
+export const waitForTOOWithUserId = async ({ page, email, loginPath = URL_PATHS.DEV_LOGIN_PATH }) => {
+  await waitForPageNavigation({ page, path: loginPath });
+  await page.locator('input[name=email]').fill(email);
+  await page.locator('p', { hasText: 'User Email' }).locator('button').click();
+};
+//await page.locator('input[name=email]').fill(email);
+//await page.locator('p', { hasText: 'User Email' }).locator('button').click();
+export const waitForTOONewLogin = async ({ page, loginPath = URL_PATHS.DEV_LOGIN_PATH }) => {
+  await waitForPageNavigation({ page, path: loginPath });
+  await loginAs.TOOOfficeUserType({ page });
+  await page.getByRole('heading', { name: 'All moves' }).waitFor();
+};
+export const waitForTIONewLogin = async ({ page, loginPath = URL_PATHS.DEV_LOGIN_PATH }) => {
+  await waitForPageNavigation({ page, path: loginPath });
+  await loginAs.TIOOfficeUserType({ page });
+  await page.getByRole('heading', { name: 'Payment requests' }).waitFor();
+};
+export const waitForPrimeNewLogin = async ({ page, loginPath = URL_PATHS.DEV_LOGIN_PATH }) => {
+  await waitForPageNavigation({ page, path: loginPath });
+  await loginAs.PrimeSimulatorUserType({ page });
+  await page.getByRole('heading', { name: 'Moves available to Prime' }).waitFor();
+};
+export const waitForServiceCounselorNewLogin = async ({ page, loginPath = URL_PATHS.DEV_LOGIN_PATH }) => {
+  await waitForPageNavigation({ page, path: loginPath });
+  await loginAs.ServicesCounselorOfficeUserType({ page });
+  await page.getByRole('heading', { name: 'Moves' }).waitFor();
+};
+export const waitForQAECSRNewLogin = async ({ page, loginPath = URL_PATHS.DEV_LOGIN_PATH }) => {
+  await waitForPageNavigation({ page, path: loginPath });
+  await loginAs.QAECSROfficeUserType({ page });
+  await page.getByRole('heading', { name: 'Search for a move' }).waitFor();
+};
+export const waitForMultiRoleUserLogin = async ({ page, loginPath = URL_PATHS.DEV_LOGIN_PATH }) => {
+  await waitForPageNavigation({ page, path: loginPath });
+  await loginAs.MultiRoleOfficeUserType({ page });
+  await page.getByText('Change user role').waitFor();
+};
+export const waitForCustomerUserLogin = async ({ page, loginPath = URL_PATHS.DEV_LOGIN_PATH }) => {
+  await waitForPageNavigation({ page, path: loginPath });
+  await loginAs.MilmoveUserType({ page });
+  await page.getByLabel('Home').waitFor();
+};
+
+export const userLoginActions = {
+  TOOOfficeUserType: waitForTOONewLogin,
+  TIOOfficeUserType: waitForTIONewLogin,
+  QAECSROfficeUserType: waitForQAECSRNewLogin,
+  ServicesCounselorOfficeUserType: waitForServiceCounselorNewLogin,
+  PrimeSimulatorUserType: waitForPrimeNewLogin,
+  MultiRoleOfficeUserType: waitForMultiRoleUserLogin,
+  MilmoveUserType: waitForCustomerUserLogin,
+};
+
+const goToOfficeUserLoginPage = async ({ page, baseURLS: { office: navToUrl } }) =>
+  await waitForLoginPage({ page, navToUrl });
+
+const goToMyMoveUserLoginPage = async ({ page, baseURLS: { my: navToUrl } }) =>
+  await waitForLoginPage({ page, navToUrl });
+
+const applyOfficeLoginPage = (key) => [key, goToOfficeUserLoginPage];
+const applyMyLoginPage = (key) => [key, goToMyMoveUserLoginPage];
+
+const getOfficeUserTypes = (({ MilmoveUserType, ...otherUserTypes }) => otherUserTypes)(allUserTypes);
+export const goToProperBasePage = Object.fromEntries([
+  ...Object.keys({ MilmoveUserType }).map(applyMyLoginPage),
+  ...Object.keys(getOfficeUserTypes).map(applyOfficeLoginPage),
+]);
