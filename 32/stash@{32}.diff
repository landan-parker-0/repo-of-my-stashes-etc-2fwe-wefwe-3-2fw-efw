+import TestHarness from '../utils/testharness';
+import * as base from '@playwright/test';
+import { stringHelpers, textWithNoTrailingNumbers } from './testActionUtils';
+export const { expect } = base;
+import { locatorHelpers } from './MixedUtilities/Helpers';
+import { getNetworkDataByMatch } from './MixedUtilities/ApiMatches';
+/**
+ * mixed test fixture for playwright
+ * See https://playwright.dev/docs/test-fixtures
+ */
+export class MixedTestPage {
+  /**
+   * Create an BaseTestPage.
+   * @param {import('@playwright/test').Page} page
+   * @param {import('@playwright/test').APIRequestContext} request
+   */
+  constructor(page, request) {
+    this.page = page;
+    this.request = request;
+    const baseMilmoveLocal = 'http://milmovelocal:3000';
+    const baseOfficeLocal = 'http://officelocal:3000';
+    const baseAdminLocal = 'http://adminlocal:3000';
+
+    this.baseURLS = {
+      my: process.env.PLAYWRIGHT_MY_URL || baseMilmoveLocal,
+      office: process.env.PLAYWRIGHT_OFFICE_URL || baseOfficeLocal,
+      admin: process.env.PLAYWRIGHT_ADMIN_URL || baseAdminLocal,
+    };
+
+    this.testHarness = new TestHarness(request);
+
+    this.helpers = {
+      waitForLoading: async () => {
+        await expect(page.locator('button:has-text("Sign out")')).toHaveCount(1, { timeout: 10000 });
+        await expect(page.locator('h2[data-name="loading-placeholder"]')).toHaveCount(0);
+      },
+      signOut: async () => {
+        await this.page.getByText('Sign out').click();
+      },
+      stringHelpers,
+      utils: {
+        textWithNoTrailingNumbers,
+      },
+      locatorHelpers: locatorHelpers(page),
+      fast: {
+        focusSelector: async (selector) => await page.locator(selector).focus(),
+        clickTextAsync: async (selector) => await page.getByText(selector).click(),
+        typeInto: async (selector, value) =>
+          (async (locator, value) => locator.focus().then(() => locator.type(value)))(page.locator(selector), value),
+        typeAndBlur: async (selector, value) => {
+          const locator = page.locator(selector);
+          await locator.type(value);
+          await locator.blur();
+        },
+        selectValue: async (selector, selectPayload) => await page.locator(selector).selectOption(selectPayload),
+      },
+    };
+  }
+}
+
+/**
+ * @typedef {object} MixedTestArgs
+ * @property {MixedTestPage} pageInstance
+ */
+
+/** @type {base.Fixtures<MixedTestArgs, {}, base.PlaywrightTestArgs & base.PlaywrightTestOptions, base.PlaywrightWorkerArgs & base.PlaywrightWorkerOptions>} */
+const mixedFixtures = {
+  pageInstance: async ({ page, request }, use) => {
+    const thePage = new MixedTestPage(page, request);
+    //await page.goto('about_blank');
+    await use(thePage);
+  },
+};
+
+export const test = base.test.extend(mixedFixtures);
+
+const getResponseJson = async (result) => {
+    expect(result.ok()).toBe(true);
+    const text = await result.text();
+    const json = JSON.parse(text);
+    return json;
+};
+
+export const addToContainer = (container, key, data) => (container[key] = data);
+export const getContainerItemFor = (container, key) => container[key];
+export const readyResponses =
+  (responses, matches) =>
+  async ({ page }) => {
+
+
+
+    const matchResult = Object.entries(matches);
+    matchResult.map(([key, match]) => {
+      const stackValues = (responses[match] ??= []);
+      stackValues.push(new Promise((res, err) => page.waitForResponse(match).then(async (response) => {
+        const result = await response;
+        console.log(await result.text());
+        const status = result.status();
+        try {
+          if(status >= 400) {
+            throw new Error("status was not okay");
+          }
+        res(await getResponseJson(result));
+        }catch(error){
+          console.log('v result');
+          console.log(result);
+          console.log('^ result');
+          console.log(error);
+          err({status, result});
+        }
+      })));
+    });
+  };
+
+export const createResponseQueueFor = (container, responses, stackName) => (key) => async (pageInstance) => {
+  const data = await getNetworkDataByMatch(stackName, responses).then((data) => addToContainer(container, key, data));
+};
+
+export const queueResponse = (responses, responseMatch) => readyResponses(responses, responseMatch);
+
+const initializeTestChain = ({ chainActions, role }) => {
+  return async ({ pageInstance }) => {
+    let task = Promise.resolve(pageInstance);
+    let setupTasks = chainActions({ role, instance: pageInstance });
+    let result = setupTasks.reduce((tasks, func) => {
+      return tasks.then(async (page) => {
+        const funcResult = await (typeof func == 'function' ? await func(page) : Promise.resolve(func));
+        return { ...page, previous: funcResult };
+      });
+    }, task);
+
+    await result;
+  };
+};
+
+export const buildTestScenarios = (items) => {
+  const entries = Object.entries(items);
+  const actions = entries.map(([key, chainActions]) => ({
+    key: key.split('_').join(' '),
+    steps: initializeTestChain({ chainActions, role: key }),
+  }));
+
+  return actions;
+};
